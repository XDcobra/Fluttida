ENV['COCOAPODS_DISABLE_STATS'] = 'true'

platform :ios, '12.0'

# CocoaPods analytics is synchronous and can slow down flutter builds.
project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise <<~MSG
      Generated.xcconfig not found. Run 'flutter pub get' and try again.
    MSG
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT=(.*)/)
    return matches[1].strip if matches
  end
  raise 'FLUTTER_ROOT not found in Generated.xcconfig. Try running flutter pub get.'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

linkage = ENV['USE_FRAMEWORKS']
if linkage
  Pod::UI.puts "Configuring Pods with #{linkage}ally linked frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

use_modular_headers!

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  # Local pod that vendores prebuilt frameworks (libcurl, OpenSSL)
  pod 'FluttidaLibs', :path => File.join(__dir__, 'LocalPods', 'FluttidaLibs')
end

post_install do |installer|
  flutter_additional_ios_build_settings(installer)
end
