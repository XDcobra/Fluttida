ENV['COCOAPODS_DISABLE_STATS'] = 'true'

platform :ios, '13.0'

# CocoaPods analytics is synchronous and can slow down flutter builds.
project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise <<~MSG
      Generated.xcconfig not found. Run 'flutter pub get' and try again.
    MSG
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT=(.*)/)
    return matches[1].strip if matches
  end
  raise 'FLUTTER_ROOT not found in Generated.xcconfig. Try running flutter pub get.'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

setup_script = File.expand_path(File.join('scripts', 'setup-libcurl-framework.sh'), __dir__)
unless ENV['FLUTTIDA_SKIP_FRAMEWORK_SETUP'] == '1'
  unless system('bash', setup_script)
    raise "Failed to run iOS framework setup: #{setup_script}"
  end
end

linkage = ENV['USE_FRAMEWORKS']
if linkage
  Pod::UI.puts "Configuring Pods with #{linkage}ally linked frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

use_modular_headers!

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  # Local pod that vendors prebuilt libcurl framework
  pod 'FluttidaLibs', :path => File.join(__dir__, 'LocalPods', 'FluttidaLibs')
end

post_install do |installer|
  # Apply Flutter's additional iOS build settings to each Pod target
  installer.pods_project.targets.each do |target|
    begin
      flutter_additional_ios_build_settings(target)
    rescue StandardError => e
      puts "Warning: flutter_additional_ios_build_settings failed for target #{target.name}: #{e.message}"
    end
  end
end
