default_platform(:android)

platform :android do
  desc "Upload AAB/APK to Play Store closed testing"
  lane :closed_testing do
    version_code = ENV['VERSION_CODE'] || ENV['ORG_GRADLE_PROJECT_VERSION_CODE']
    version_name = ENV['VERSION_NAME'] || ENV['ORG_GRADLE_PROJECT_VERSION_NAME']
    release_name = version_code && version_name ? "#{version_code} (#{version_name})" : nil

    aab_path = Dir["app/build/outputs/bundle/release/*.aab"].first || "app/build/outputs/bundle/release/app-release.aab"
    apk_path = Dir["app/build/outputs/flutter-apk/*.apk"].first || "app/build/outputs/flutter-apk/app-release.apk"

    if File.exist?(aab_path)
      supply(
        aab: aab_path,
        mapping: "app/build/outputs/mapping/release/mapping.txt",
        track: "closed",
        release_name: release_name,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: true
      )
    elsif File.exist?(apk_path)
      supply(
        apk: apk_path,
        mapping: "app/build/outputs/mapping/release/mapping.txt",
        track: "closed",
        release_name: release_name,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: true
      )
    else
      UI.user_error!("No AAB or APK found to upload to Play Store")
    end
  end
end
